# Next.js Frontend Environment Variables Template
# Copy this file to .env.local and fill in the values

# App Configuration
NEXT_PUBLIC_APP_NAME=AMKyawDev Recap App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# FFmpeg WASM Configuration
NEXT_PUBLIC_FFMPEG_WASM_PATH=/ffmpeg
NEXT_PUBLIC_FFMPEG_CORE_URL=https://your-cdn-url.com/ffmpeg

# Optional Features
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_DEBUG_MODE=false

# API Configuration (if needed)
# NEXT_PUBLIC_API_URL=https://api.example.com